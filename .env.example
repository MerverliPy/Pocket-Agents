# Pocket-Agents environment configuration
# Copy this file to .env and fill in your values.
# All PA_* variables are optional — built-in defaults are used when absent.

# Log level: error | warn | info | debug  (default: info)
PA_LOG_LEVEL=info

# Absolute path to the workspace root  (default: process.cwd())
# PA_WORKSPACE_ROOT=/path/to/your/project

# Absolute path to the runtime data directory  (default: <workspaceRoot>/.pocket-agents)
# PA_DATA_DIR=/path/to/data

# Allow agents and tools to execute shell commands  (default: false)
# PA_ALLOW_SHELL=false

# Allow agents and tools to make outbound HTTP requests  (default: false)
# PA_ALLOW_HTTP=false

# Allow agents and tools to write to the filesystem  (default: false)
# PA_ALLOW_FILE_WRITE=false

# Maximum CLI command timeout in milliseconds  (default: 30000)
# PA_COMMAND_TIMEOUT_MS=30000

# Path to an optional JSON config file  (default: ./pocket-agents.config.json if present)
# PA_CONFIG_FILE=/path/to/pocket-agents.config.json

# Optional path to a local JSONL event log file.
# When set, all emitted EventRecords are appended to this file.
# Leave unset (or empty) to disable the JSONL sink.
# PA_EVENTS_FILE=/path/to/events.jsonl
